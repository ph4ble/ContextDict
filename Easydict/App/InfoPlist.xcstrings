    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ContextDict requires permission to read selected text from supported applications and execute AppleScript when needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ContextDict が対応アプリから選択テキストを読み取り、必要に応じて AppleScript を実行するには権限が必要です。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ContextDict vyžaduje povolenie na čítanie vybraného textu z podporovaných aplikácií a na vykonanie AppleScriptu podľa potreby."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ContextDict 需要权限来读取受支持应用中的选中文本，并在必要时执行 AppleScript。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ContextDict 需要權限來讀取支援應用程式中的選取文字，並在必要時執行 AppleScript。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ContextDict requiere permiso para leer texto seleccionado de aplicaciones compatibles y ejecutar AppleScript cuando sea necesario."
          }
        }
      }
